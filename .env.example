# ─────────────────────────────────────────────────────────────
# ScopeSeal — environment variables
# Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public app config
NEXT_PUBLIC_APP_URL="https://scopeseal.codezela.com"

# Database (NeonDB Postgres pooler URL).
# NOTE: remove `channel_binding=require` if present. Use certificate verification
# and the Neon -pooler endpoint. The app also normalizes legacy URLs safely.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/dbname?sslmode=verify-full"

# Auth.js v5
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Initial administrator created by `pnpm db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# Transactional email (Resend). Verify the sender domain first.
RESEND_API_KEY=""
RESEND_EMAIL_FROM=""
# Inbox that receives contact-form messages.
CONTACT_EMAIL_TO=""

# Encryption key for admin-stored provider API keys (32-byte hex = 64 chars).
# Generate with: openssl rand -hex 32
AI_ENCRYPTION_KEY=""

# Guest / rate limiting
GUEST_REPORT_QUOTA="3"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="10"

# Distributed rate limiting. Set both in production. If unset, the app uses a
# bounded per-instance fallback suitable for local development.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# AI providers are configured by an administrator in /admin/ai-config.
